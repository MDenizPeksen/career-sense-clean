# Treat lockfiles as generated: GitHub collapses them in diffs by default and
# excludes them from language statistics. They're still committed (best practice
# for reproducible installs) — this only affects how they're displayed.
package-lock.json linguist-generated=true
**/package-lock.json linguist-generated=true
# Generated Prisma migration SQL.
backend/prisma/migrations/** linguist-generated=true

# NOTE: media (mp4/jpg/png/webm) is intentionally NOT tracked via Git LFS.
# Vercel's build checkout does not smudge LFS pointers, so LFS-tracked assets
# deploy as 132-byte pointer files and fail to load. These assets are small
# (~4 MB total), so we commit them as regular git blobs instead.
