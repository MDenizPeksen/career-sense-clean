# CareerSense Frontend (Vite) Environment Variables
# Copy this file to .env.local and fill in your values. NEVER commit a real .env.local.

# Backend API base URL (the deployed Render/Railway URL in production)
VITE_API_URL=http://localhost:5001

# Clerk publishable key (safe to expose in the client bundle)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# Auth toggle — set to false to bypass the login gate during testing.
# Leave true (or unset) in production.
VITE_AUTH_ENABLED=true

# Error monitoring (Sentry). OPTIONAL: when unset, Sentry is a no-op.
# Create a React project in Sentry and paste its DSN here.
VITE_SENTRY_DSN=
