# CareerSense Frontend Environment Variables
# Copy this file to .env and fill in your values

# API Configuration
REACT_APP_API_URL=http://localhost:5001
REACT_APP_API_TIMEOUT=30000

# Feature Flags
REACT_APP_ENABLE_MOCK_INTERVIEWS=true
REACT_APP_ENABLE_CAREER_PATHS=true

# Performance Settings
REACT_APP_ENABLE_API_CACHE=true
REACT_APP_CACHE_DURATION=300  # 5 minutes in seconds

# Analytics (if needed in the future)
REACT_APP_ANALYTICS_ID=

# Development Settings
REACT_APP_DEBUG_MODE=false
