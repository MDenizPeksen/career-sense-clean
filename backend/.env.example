# CareerSense Backend Environment Variables
# Copy this file to .env and fill in your values. NEVER commit a real .env.

# Server Configuration
PORT=5001
NODE_ENV=development
ENABLE_CLUSTERING=false

# CORS — comma-separated list of allowed frontend origins.
# In production set this to your deployed frontend URL (e.g. https://your-app.vercel.app).
ALLOWED_ORIGINS=http://localhost:3000

# Database (Postgres via Prisma). Use a Neon connection string (https://neon.tech).
# Include `?sslmode=require` for Neon. After setting this, run:
#   npx prisma migrate dev --name init   (first time, creates tables)
#   npx prisma generate                  (regenerates the client)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# OpenAI API Configuration
OPENAI_API_KEY=your-openai-api-key-here
# gpt-4o-mini is the default. Upgrade (e.g. gpt-4.1-mini) once enabled for your
# OpenAI project under Project -> Limits -> model access.
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=1000

# Auth toggle — set to false to DISABLE Clerk verification on protected routes
# (handy for local testing). Leave true (or unset) in production.
AUTH_ENABLED=true

# Clerk (server-side token verification for protected routes)
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# File Upload Configuration
MAX_FILE_SIZE=10485760  # 10MB in bytes
ALLOWED_FILE_TYPES=pdf,doc,docx

# Rate Limiting
RATE_LIMIT_WINDOW_MS=3600000  # 1 hour in milliseconds
RATE_LIMIT_MAX_REQUESTS=100
CV_ANALYSIS_RATE_LIMIT=20  # requests per hour for resource-intensive operations

# Cache Configuration
CACHE_DURATION=300  # 5 minutes in seconds
